  "description": "10 個面板。綜合健康同時檢查原生池狀態與 SNMP extend 成員狀態；容量使用 zpool list 的實體配置值。2026-10-19 成員故障整合版。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "每站同時監測資料池與 boot-pool。DEGRADED 僅在原生池狀態為 DEGRADED 時顯示；池仍 ONLINE 但成員有 FAULTED 等異常時，顯示紅色「成員異常」。成員資料含所有池，不能藉此定位到個別磁碟或特定池；請查看 zpool status -P。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ONLINE 正常",
                  "color": "#73BF69",
                  "index": 0
                },
                "1": {
                  "text": "DEGRADED 降級",
                  "color": "#FF9830",
                  "index": 1
                },
                "2": {
                  "text": "儲存池異常",
                  "color": "#F2495C",
                  "index": 2
                },
                "3": {
                  "text": "成員異常／冗餘需檢查",
                  "color": "#F2495C",
                  "index": 3
                },
                "4": {
                  "text": "健康資料不完整",
                  "color": "#B877D9",
                  "index": 4
                }
              }
            }
          ],
          "noValue": "未知／無資料",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              },
              {
                "color": "purple",
                "value": 4
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "id": 111,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 23
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(((max(zpoolHealthStr{job=\"truenas_snmp\",instance=\"100.114.236.88\",zpoolName=~\"mainpool|boot-pool\",zpoolHealthStr!~\"ONLINE|DEGRADED\"} == 1) * 0 + 2) or on() (max(zpoolHealthStr{job=\"truenas_snmp\",instance=\"100.114.236.88\",zpoolName=~\"mainpool|boot-pool\",zpoolHealthStr=\"DEGRADED\"} == 1) * 0 + 1) or on() (((max(zfsMemberFault{job=\"truenas_snmp\",instance=\"100.114.236.88\"}) == 1) and on() (max(zfsStatusCommandExit{job=\"truenas_snmp\",instance=\"100.114.236.88\"}) == 0)) * 0 + 3) or on() (((count(max by(zpoolName) (zpoolHealthStr{job=\"truenas_snmp\",instance=\"100.114.236.88\",zpoolName=~\"mainpool|boot-pool\",zpoolHealthStr=\"ONLINE\"} == 1)) == 2) and on() (max(zfsMemberFault{job=\"truenas_snmp\",instance=\"100.114.236.88\"}) == 0) and on() (max(zfsStatusCommandExit{job=\"truenas_snmp\",instance=\"100.114.236.88\"}) == 0)) * 0)) and on() (max(up{job=\"truenas_snmp\",instance=\"100.114.236.88\"}) == 1)) or on() vector(4)",
          "instant": true,
          "legendFormat": "TrueNAS A｜mainpool / boot-pool",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(((max(zpoolHealthStr{job=\"truenas_snmp\",instance=\"100.113.107.95\",zpoolName=~\"backuppool|boot-pool\",zpoolHealthStr!~\"ONLINE|DEGRADED\"} == 1) * 0 + 2) or on() (max(zpoolHealthStr{job=\"truenas_snmp\",instance=\"100.113.107.95\",zpoolName=~\"backuppool|boot-pool\",zpoolHealthStr=\"DEGRADED\"} == 1) * 0 + 1) or on() (((max(zfsMemberFault{job=\"truenas_snmp\",instance=\"100.113.107.95\"}) == 1) and on() (max(zfsStatusCommandExit{job=\"truenas_snmp\",instance=\"100.113.107.95\"}) == 0)) * 0 + 3) or on() (((count(max by(zpoolName) (zpoolHealthStr{job=\"truenas_snmp\",instance=\"100.113.107.95\",zpoolName=~\"backuppool|boot-pool\",zpoolHealthStr=\"ONLINE\"} == 1)) == 2) and on() (max(zfsMemberFault{job=\"truenas_snmp\",instance=\"100.113.107.95\"}) == 0) and on() (max(zfsStatusCommandExit{job=\"truenas_snmp\",instance=\"100.113.107.95\"}) == 0)) * 0)) and on() (max(up{job=\"truenas_snmp\",instance=\"100.113.107.95\"}) == 1)) or on() vector(4)",
          "instant": true,
          "legendFormat": "TrueNAS B｜backuppool / boot-pool",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "A／B ZFS 綜合健康（儲存池＋成員）",
      "type": "stat",
      "transformations": []
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "SNMP 採集成功不代表磁碟健康。S3 API 成功不代表 Cloud Sync 最近完成。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "#F2495C",
                  "index": 1,
                  "text": "異常"
                },
                "1": {
                  "color": "#73BF69",
                  "index": 0,
                  "text": "正常"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "未知",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2495C",
                "value": null
              },
              {
                "color": "#73BF69",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "id": 110,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "text": {
          "titleSize": 16,
          "valueSize": 24
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "up{job=\"truenas_snmp\",instance=\"100.114.236.88\"} or on () vector(0)",
          "instant": true,
          "legendFormat": "TrueNAS A",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "up{job=\"truenas_snmp\",instance=\"100.113.107.95\"} or on () vector(0)",
          "instant": true,
          "legendFormat": "TrueNAS B",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "min(aws_s3_bucket_health_status{job=\"aws_s3\",bucket_name=\"truenas-backup-myhome-2026\"}) * on () min(up{job=\"aws_s3\"}) or on () vector(0)",
          "instant": true,
          "legendFormat": "S3 API",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "採集連線／S3 API",
      "type": "stat"
    },
